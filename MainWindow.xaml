<Window x:Class="VideoSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Selector" Height="600" Width="900"
        Background="#1e1e1e" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnSelectFolder" Content="Select Folder" Click="BtnSelectFolder_Click" Width="120" Height="30" Background="#333" Foreground="White" BorderBrush="#555"/>
            <TextBlock x:Name="TxtStatus" Text="No folder selected" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
        </StackPanel>

        <!-- Media Player -->
        <Border Grid.Row="1" Background="Black" CornerRadius="5" ClipToBounds="True">
            <MediaElement x:Name="MediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"/>
        </Border>

        <!-- Bottom Controls -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Slider x:Name="TimelineSlider" Grid.Row="0" Margin="0,0,0,10" Minimum="0" Value="0" 
                    IsMoveToPointEnabled="True"
                    Thumb.DragStarted="TimelineSlider_DragStarted"
                    Thumb.DragCompleted="TimelineSlider_DragCompleted"
                    PreviewMouseLeftButtonUp="TimelineSlider_MouseUp"/>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnPlayPause" Content="Pause" Click="BtnPlayPause_Click" Width="80" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbSpeed" Width="60" Height="35" VerticalContentAlignment="Center" SelectionChanged="CmbSpeed_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="1x"/>
                        <ComboBoxItem Content="2x"/>
                        <ComboBoxItem Content="4x"/>
                        <ComboBoxItem Content="6x"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="No video" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtVideoInfo" Text="" FontSize="12" Foreground="#aaa" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnReject" Content="Reject" Click="BtnReject_Click" Width="100" Height="35" Background="#d13438" Foreground="White" BorderThickness="0" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button x:Name="BtnPrevious" Content="&#x2B05; Prev" Click="BtnPrevious_Click" Width="80" Height="35" Background="#0078d7" Foreground="White" BorderThickness="0" Margin="0,0,5,0" FontWeight="Bold"/>
                    <Button x:Name="BtnNext" Content="Next ➔" Click="BtnNext_Click" Width="80" Height="35" Background="#0078d7" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
