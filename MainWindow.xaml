<Window x:Class="VideoSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Selector" Height="600" Width="900"
        Background="#1e1e1e" Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnSelectFolder" Content="Select Folder" Click="BtnSelectFolder_Click" Width="120" Height="30" Background="#333" Foreground="White" BorderBrush="#555"/>
                <TextBlock x:Name="TxtStatus" Text="No folder selected" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtFileName" Text="No video" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtVideoInfo" Text="" FontSize="12" Foreground="#aaa" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Media Player -->
        <Border Grid.Row="1" Background="Black" CornerRadius="5" ClipToBounds="True">
            <MediaElement x:Name="MediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"/>
        </Border>

        <!-- Bottom Controls -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Slider x:Name="TimelineSlider" Grid.Row="0" Margin="0,0,0,10" Minimum="0" Value="0" 
                    IsMoveToPointEnabled="True"
                    Thumb.DragStarted="TimelineSlider_DragStarted"
                    Thumb.DragCompleted="TimelineSlider_DragCompleted"
                    ValueChanged="TimelineSlider_ValueChanged"/>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtCounter" Grid.Column="0" Text="" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White" Margin="0,0,0,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSpeed1x" Content="1x" Click="BtnSpeed_Click" Width="40" Height="35" Background="#0078d7" Foreground="White" BorderBrush="#555" Margin="0,0,5,0" Tag="1"/>
                    <Button x:Name="BtnSpeed2x" Content="2x" Click="BtnSpeed_Click" Width="40" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,5,0" Tag="2"/>
                    <Button x:Name="BtnSpeed3x" Content="3x" Click="BtnSpeed_Click" Width="40" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,5,0" Tag="3"/>
                    <Button x:Name="BtnSpeed4x" Content="4x" Click="BtnSpeed_Click" Width="40" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,5,0" Tag="4"/>
                    <Button x:Name="BtnSpeed6x" Content="6x" Click="BtnSpeed_Click" Width="40" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,15,0" Tag="6"/>
                    
                    <Button x:Name="BtnPlayPause" Content="Pause" Click="BtnPlayPause_Click" Width="80" Height="35" Background="#333" Foreground="White" BorderBrush="#555" Margin="0,0,15,0"/>
                    
                    <Button x:Name="BtnReject" Content="Reject" Click="BtnReject_Click" Width="100" Height="35" Background="#d13438" Foreground="White" BorderThickness="0" Margin="0,0,5,0" FontWeight="Bold"/>
                    <Button x:Name="BtnUndo" Content="Undo" Click="BtnUndo_Click" Width="60" Height="35" Margin="0,0,15,0" FontWeight="Bold" IsEnabled="False">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#f2a900" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#ffc333" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#333333" />
                                                    <Setter Property="Foreground" Value="#666666" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnPrevious" Content="&#x2B05; Prev" Click="BtnPrevious_Click" Width="80" Height="35" Background="#0078d7" Foreground="White" BorderThickness="0" Margin="0,0,5,0" FontWeight="Bold"/>
                    <Button x:Name="BtnNext" Content="Next ➔" Click="BtnNext_Click" Width="80" Height="35" Background="#0078d7" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
